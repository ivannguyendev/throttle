{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist-test",
    "types": ["node"],
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*"]
}
